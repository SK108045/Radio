NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Optional CA override. Supabase connections use the bundled official public CA.
# DATABASE_CA_CERT=/path/to/database-ca.crt
SOZURI_API_KEY=
SOZURI_PROJECT=
SOZURI_SENDER=Sozuri
SOZURI_SMS_TYPE=promotional
SALES_OTP_SECRET=
SWIFTA_API_KEY=
DOMAIN_PAYMENT_SECRET=
SALES_RECONCILE_SECRET=
SALES_SITE_URL=https://YOUR_HOST
GEMINI_API_KEY=
# Optional system FFmpeg override. Bundled ffmpeg-static is used by default.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional, provider-issued responsive INLINE banner zones (not the Catfish ID).
# Leave empty to show labelled RIENG house promotions without ad requests.
NEXT_PUBLIC_AD_ZONE_PLAYER=
NEXT_PUBLIC_AD_ZONE_FEED=
NEXT_PUBLIC_AD_ZONE_FOOTER=
